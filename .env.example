# =============================================================================
# Environment Configuration Template
# =============================================================================
#
# Copy this file to `.env` and fill in the values for your environment.
#
# SECURITY NOTES:
# ---------------
# This .env file is bundled into the app assets during build, which means:
# - Values can be extracted by decompiling the APK/IPA
# - This is NOT suitable for truly sensitive secrets
#
# For truly sensitive secrets, use:
# - Backend-provided secrets: Fetch secrets from your API after authentication
# - Native platform secrets: Store in iOS Keychain / Android Keystore
# - Build-time injection with obfuscation: Use --dart-define + envied package
#
# The values in this file are acceptable because they are:
# - Public identifiers (like OAuth client IDs)
# - Non-sensitive configuration values
#
# =============================================================================

# Google OAuth Web Client ID (for serverClientId)
# This is the Web Client ID from Google Cloud Console, NOT the Android/iOS Client ID.
GOOGLE_SERVER_CLIENT_ID=your-web-client-id.apps.googleusercontent.com

# Client Application Identifier
# Sent as "Client-App" header in all API requests to identify the consuming application.
# Valid values: MobileApp (iOS/Android), WebApp (SPA), Dashboard (Admin panel)
CLIENT_APP=MobileApp
